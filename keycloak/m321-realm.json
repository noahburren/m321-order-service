{
  "realm": "m321",
  "displayName": "M321 Order Service",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "USER", "description": "May create orders" },
      { "name": "ADMIN", "description": "May create orders and access the admin endpoint" }
    ]
  },
  "clients": [
    {
      "clientId": "m321-order-client",
      "name": "M321 Order Service Demo Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "demo-user",
      "email": "demo-user@example.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "user123", "temporary": false }
      ],
      "realmRoles": ["USER"]
    },
    {
      "username": "demo-admin",
      "email": "demo-admin@example.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["ADMIN"]
    }
  ]
}
